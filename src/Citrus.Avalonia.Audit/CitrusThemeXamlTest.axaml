<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:citrus="clr-namespace:Citrus.Avalonia;assembly=Citrus.Avalonia"
        x:Class="Citrus.Avalonia.Audit.CitrusThemeXamlTest">
    <!-- Same usage as the README "Example implementation (xaml only)" -->
    <citrus:CitrusTheme>
        <citrus:CitrusTheme.DesiredDarkThemeVariant>
            <ResourceInclude Source="avares://Citrus.Avalonia/Palette/RustPalette.xaml"/>
        </citrus:CitrusTheme.DesiredDarkThemeVariant>
    </citrus:CitrusTheme>
</Styles>
