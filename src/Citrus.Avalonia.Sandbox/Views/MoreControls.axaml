<UserControl x:Class="Citrus.Avalonia.Sandbox.Views.MoreControls"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Citrus.Avalonia.Sandbox.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             Background="{DynamicResource ThemeBackgroundBrush}">

    <Design.DesignStyle>
        <SimpleTheme />
    </Design.DesignStyle>

    <Design.DataContext>
        <viewModels:MainWindowViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="*,*">
        <Border Classes="Card" Grid.Column="0">
            <StackPanel Spacing="10">
                <!-- ToggleSwitch -->
                <Label Classes="Heading" Content="ToggleSwitch"/>
                <Grid ColumnDefinitions="*,*,*,*">
                    <ToggleSwitch Grid.Column="0"
                                  Content="Unchecked" />
                    <ToggleSwitch Grid.Column="1"
                                  IsChecked="True"
                                  Content="Checked" />
                    <ToggleSwitch Grid.Column="2"
                                  Classes="Primary"
                                  IsChecked="True"
                                  Content="Checked Primary" />
                    <ToggleSwitch Grid.Column="3"
                                  IsEnabled="False"
                                  IsChecked="True"
                                  Content="Disabled" />
                </Grid>

                <!-- DropDownButton -->
                <Label Classes="Heading" Content="DropDownButton"/>
                <Grid ColumnDefinitions="*,10,*,10,*">
                    <DropDownButton Grid.Column="0"
                                    Content="DropDownButton">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Option 1"/>
                                <MenuItem Header="Option 2"/>
                                <MenuItem Header="Option 3"/>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <DropDownButton Grid.Column="2"
                                    Classes="Primary"
                                    Content="Primary">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Option 1"/>
                                <MenuItem Header="Option 2"/>
                                <MenuItem Header="Option 3"/>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <DropDownButton Grid.Column="4"
                                    IsEnabled="False"
                                    Content="Disabled" />
                </Grid>

                <!-- SplitButton -->
                <Label Classes="Heading" Content="SplitButton and ToggleSplitButton"/>
                <Grid ColumnDefinitions="*,10,*,10,*">
                    <SplitButton Grid.Column="0"
                                 Content="SplitButton">
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Option 1"/>
                                <MenuItem Header="Option 2"/>
                                <MenuItem Header="Option 3"/>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <SplitButton Grid.Column="2"
                                 Classes="Primary"
                                 Content="Primary">
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Option 1"/>
                                <MenuItem Header="Option 2"/>
                                <MenuItem Header="Option 3"/>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <SplitButton Grid.Column="4"
                                 IsEnabled="False"
                                 Content="Disabled" />
                </Grid>
                <Grid ColumnDefinitions="*,10,*,10,*">
                    <ToggleSplitButton Grid.Column="0"
                                       Content="Unchecked">
                        <ToggleSplitButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Option 1"/>
                                <MenuItem Header="Option 2"/>
                            </MenuFlyout>
                        </ToggleSplitButton.Flyout>
                    </ToggleSplitButton>
                    <ToggleSplitButton Grid.Column="2"
                                       IsChecked="True"
                                       Content="Checked">
                        <ToggleSplitButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Option 1"/>
                                <MenuItem Header="Option 2"/>
                            </MenuFlyout>
                        </ToggleSplitButton.Flyout>
                    </ToggleSplitButton>
                    <ToggleSplitButton Grid.Column="4"
                                       IsEnabled="False"
                                       IsChecked="True"
                                       Content="Disabled" />
                </Grid>

                <!-- HyperlinkButton -->
                <Label Classes="Heading" Content="HyperlinkButton"/>
                <Grid ColumnDefinitions="*,*,*">
                    <HyperlinkButton Grid.Column="0"
                                     NavigateUri="https://github.com/drone1400/Citrus.Avalonia"
                                     Content="Citrus.Avalonia on GitHub" />
                    <HyperlinkButton Grid.Column="1"
                                     NavigateUri="https://github.com/drone1400/Citrus.Avalonia"
                                     IsVisited="True"
                                     Content="Visited link" />
                    <HyperlinkButton Grid.Column="2"
                                     IsEnabled="False"
                                     Content="Disabled link" />
                </Grid>

                <!-- Notifications, shown in the bottom right corner of the window -->
                <Label Classes="Heading" Content="NotificationCard and WindowNotificationManager"/>
                <Grid ColumnDefinitions="*,10,*,10,*,10,*">
                    <Button Grid.Column="0"
                            Tag="Information"
                            Content="Information"
                            Click="OnShowNotification" />
                    <Button Grid.Column="2"
                            Tag="Success"
                            Content="Success"
                            Click="OnShowNotification" />
                    <Button Grid.Column="4"
                            Tag="Warning"
                            Content="Warning"
                            Click="OnShowNotification" />
                    <Button Grid.Column="6"
                            Tag="Error"
                            Content="Error"
                            Click="OnShowNotification" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="Card" Grid.Column="1">
            <StackPanel Spacing="10">
                <!-- SplitView, the compact pane is as wide as the icons with their margin -->
                <Label Classes="Heading" Content="SplitView"/>
                <SplitView x:Name="splitView"
                           Height="150"
                           DisplayMode="CompactInline"
                           IsPaneOpen="True"
                           OpenPaneLength="160"
                           Background="{DynamicResource ThemeBackgroundBrush}">
                    <SplitView.Pane>
                        <StackPanel Margin="14,10" Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <PathIcon Data="M 12,3 L 2,12 L 5,12 L 5,21 L 19,21 L 19,12 L 22,12 Z" />
                                <TextBlock Text="Home" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <PathIcon Data="M 12,2 L 15,9 L 22,9 L 16.5,13.5 L 18.5,21 L 12,16.5 L 5.5,21 L 7.5,13.5 L 2,9 L 9,9 Z" />
                                <TextBlock Text="Favorites" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <PathIcon Data="M 2,12 L 9,19 L 22,6 L 19,3 L 9,13 L 5,9 Z" />
                                <TextBlock Text="Done" />
                            </StackPanel>
                        </StackPanel>
                    </SplitView.Pane>
                    <StackPanel Margin="10" Spacing="10">
                        <ToggleButton HorizontalAlignment="Left"
                                      IsChecked="{Binding #splitView.IsPaneOpen}"
                                      Content="Open pane" />
                        <TextBlock Text="Content next to the pane" />
                    </StackPanel>
                </SplitView>

                <!-- Carousel -->
                <Label Classes="Heading" Content="Carousel"/>
                <Grid ColumnDefinitions="Auto,10,*,10,Auto">
                    <Button Grid.Column="0"
                            VerticalAlignment="Center"
                            Content="Previous"
                            Click="OnCarouselPrevious" />
                    <Carousel Grid.Column="2"
                              x:Name="carousel"
                              Height="80"
                              WrapSelection="True">
                        <Carousel.PageTransition>
                            <PageSlide Duration="0:0:0.25" Orientation="Horizontal" />
                        </Carousel.PageTransition>
                        <Border CornerRadius="5" Background="{DynamicResource ThemeAccentBrush}">
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{DynamicResource HighlightForegroundBrush}"
                                       Text="Page 1" />
                        </Border>
                        <Border CornerRadius="5" Background="{DynamicResource ThemeBorderHighBrush}">
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{DynamicResource HighlightForegroundBrush}"
                                       Text="Page 2" />
                        </Border>
                        <Border CornerRadius="5" Background="{DynamicResource HighlightBrush}">
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{DynamicResource HighlightForegroundBrush}"
                                       Text="Page 3" />
                        </Border>
                    </Carousel>
                    <Button Grid.Column="4"
                            VerticalAlignment="Center"
                            Content="Next"
                            Click="OnCarouselNext" />
                </Grid>

                <!-- RefreshContainer, pull to refresh only works with touch or a pen, the button works with a mouse -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Classes="Heading"
                           Content="RefreshContainer" />
                    <Button Grid.Column="1"
                            Content="Refresh"
                            Click="OnRefresh" />
                </Grid>
                <Label Classes="Caption"
                       Content="Pull the list down with touch or a pen, or click Refresh" />
                <RefreshContainer x:Name="refreshContainer"
                                  Height="120"
                                  RefreshRequested="OnRefreshRequested">
                    <ListBox x:Name="refreshList" />
                </RefreshContainer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
