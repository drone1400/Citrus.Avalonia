<UserControl x:Class="Citrus.Avalonia.Sandbox.Views.TabStrips"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sandbox="clr-namespace:Citrus.Avalonia.Sandbox"
             xmlns:viewModels="clr-namespace:Citrus.Avalonia.Sandbox.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             Background="{DynamicResource ThemeBackgroundBrush}">

    <Design.DesignStyle>
        <SimpleTheme />
    </Design.DesignStyle>

    <Design.DataContext>
        <viewModels:MainWindowViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="*,*">
        <Border Classes="Card" Grid.Column="0">
            <StackPanel Spacing="10">
                <Label Classes="Heading" Content="TabStrip"/>
                <TabStrip>
                    <TabStripItem Content="Item 1"/>
                    <TabStripItem Content="Item 2"/>
                    <TabStripItem Content="Item 3"/>
                    <TabStripItem Content="Disabled" IsEnabled="False"/>
                </TabStrip>
                
                <Label Classes="Heading" Content="Disabled TabStrip"/>
                <TabStrip IsEnabled="False">
                    <TabStripItem Content="Item 1"/>
                    <TabStripItem Content="Item 2"/>
                    <TabStripItem Content="Item 3"/>
                    <TabStripItem Content="Disabled" IsEnabled="False"/>
                </TabStrip>
                
                <Label Classes="Heading" Content="Separator"/>
                
                <Separator />
                
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="10">
                        <Label Classes="Heading" Content="PathIcon"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="M 2,12 L 9,19 L 22,6 L 19,3 L 9,13 L 5,9 Z" />
                            <PathIcon Data="M 12,2 L 22,22 L 2,22 Z"
                                      Foreground="{DynamicResource ThemeAccentBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="10">
                        <Label Classes="Heading" Content="SelectableTextBlock"/>
                        <SelectableTextBlock Text="Select and copy this text"
                                             SelectionStart="0" SelectionEnd="6" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="10">
                        <Label Classes="Heading" Content="HeaderedContentControl"/>
                        <HeaderedContentControl Header="Header" Content="Content" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="10">
                        <Label Classes="Heading" Content="TransitioningContentControl"/>
                        <TransitioningContentControl Content="Content" />
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>
        
        <Border Classes="Card" Grid.Column="1">
            <Grid ColumnDefinitions="*,Auto,*">
                <Rectangle Grid.Column="0" Fill="Red" />
                <GridSplitter Grid.Column="1" />
                   
                <Grid Grid.Column="2" RowDefinitions="*,Auto,*">
                    <Rectangle Grid.Row="0" Fill="Blue" />
                    <GridSplitter Grid.Row="1" />
                    <Rectangle Grid.Row="2" Fill="Green" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>